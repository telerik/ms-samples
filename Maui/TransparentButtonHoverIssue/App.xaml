<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="TransparentHoverRepro.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Application.Resources>
        <ResourceDictionary>

            <!--
                Source is assigned in XAML, as required by .NET MAUI.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/LightTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Base style: solid background + border + all common states -->
            <Style x:Key="BaseButtonStyle"
                   TargetType="Button">

                <Setter Property="BackgroundColor"
                        Value="{DynamicResource ButtonBackgroundColor}" />

                <Setter Property="BorderColor"
                        Value="{DynamicResource ButtonBorderColor}" />

                <Setter Property="TextColor"
                        Value="{DynamicResource ButtonTextColor}" />

                <Setter Property="BorderWidth"
                        Value="1" />

                <Setter Property="CornerRadius"
                        Value="6" />

                <Setter Property="Padding"
                        Value="20,10" />

                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">

                            <!--
                                Normal intentionally has no setters.
                                The regular Style setters define the Normal appearance.
                                This lets a BasedOn style override only BackgroundColor.
                            -->
                            <VisualState x:Name="Normal" />

                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="{DynamicResource ButtonHoverBackgroundColor}" />
                                    <Setter Property="BorderColor"
                                            Value="{DynamicResource ButtonHoverBorderColor}" />
                                    <Setter Property="TextColor"
                                            Value="{DynamicResource ButtonHoverTextColor}" />
                                </VisualState.Setters>
                            </VisualState>

                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="{DynamicResource ButtonPressedBackgroundColor}" />
                                    <Setter Property="BorderColor"
                                            Value="{DynamicResource ButtonPressedBorderColor}" />
                                    <Setter Property="TextColor"
                                            Value="{DynamicResource ButtonPressedTextColor}" />
                                </VisualState.Setters>
                            </VisualState>

                            <VisualState x:Name="Focused">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="{DynamicResource ButtonBackgroundColor}" />
                                    <Setter Property="BorderColor"
                                            Value="{DynamicResource ButtonFocusedBorderColor}" />
                                    <Setter Property="TextColor"
                                            Value="{DynamicResource ButtonFocusedTextColor}" />
                                </VisualState.Setters>
                            </VisualState>

                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor"
                                            Value="{DynamicResource ButtonDisabledBackgroundColor}" />
                                    <Setter Property="BorderColor"
                                            Value="{DynamicResource ButtonDisabledBorderColor}" />
                                    <Setter Property="TextColor"
                                            Value="{DynamicResource ButtonDisabledTextColor}" />
                                </VisualState.Setters>
                            </VisualState>

                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!--
                Repro style:
                inherit all states from BaseButtonStyle and override only
                the normal BackgroundColor.
            -->
            <Style x:Key="TransparentButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="BackgroundColor"
                        Value="Transparent" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>

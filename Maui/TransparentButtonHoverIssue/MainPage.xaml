<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TransparentHoverRepro.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{DynamicResource PageBackgroundColor}">

    <Grid Padding="40"
          RowDefinitions="Auto,Auto,Auto,Auto,*"
          RowSpacing="18"
          MaximumWidthRequest="720"
          HorizontalOptions="Center">

        <Label Grid.Row="0"
               Text="Transparent Button Hover Repro"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="{DynamicResource PageTextColor}" />

        <Label Grid.Row="1"
               Text="Move the mouse over both buttons. The second button has a Transparent normal background and uses #B2F9F9F9 for PointerOver."
               FontSize="14"
               TextColor="{DynamicResource SecondaryTextColor}" />

        <VerticalStackLayout Grid.Row="2"
                             Spacing="10">

            <Label Text="1. Base button — solid background"
                   TextColor="{DynamicResource PageTextColor}" />

            <Button Text="Base Button"
                    WidthRequest="240"
                    HorizontalOptions="Start"
                    Style="{StaticResource BaseButtonStyle}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="3"
                             Spacing="10">

            <Label Text="2. BasedOn button — Transparent normal background"
                   TextColor="{DynamicResource PageTextColor}" />

            <Button Text="Transparent Button"
                    WidthRequest="240"
                    HorizontalOptions="Start"
                    Style="{StaticResource TransparentButtonStyle}" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>

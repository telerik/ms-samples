<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Page -->
    <Color x:Key="PageBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="PageTextColor">#1F1F1F</Color>
    <Color x:Key="SecondaryTextColor">#666666</Color>

    <!-- Normal -->
    <Color x:Key="ButtonBackgroundColor">#cccccc</Color>
    <Color x:Key="ButtonBorderColor">#FF8A8A8A</Color>
    <Color x:Key="ButtonTextColor">#FF1F1F1F</Color>

    <!-- PointerOver: exact repro color requested -->
    <Color x:Key="ButtonHoverBackgroundColor">#B2F9F9F9</Color>
    <Color x:Key="ButtonHoverBorderColor">#FF707070</Color>
    <Color x:Key="ButtonHoverTextColor">#FF1F1F1F</Color>

    <!-- Pressed -->
    <Color x:Key="ButtonPressedBackgroundColor">#FFE1E1E1</Color>
    <Color x:Key="ButtonPressedBorderColor">#FF5F5F5F</Color>
    <Color x:Key="ButtonPressedTextColor">#FF111111</Color>

    <!-- Focused -->
    <Color x:Key="ButtonFocusedBackgroundColor">#FFF3F3F3</Color>
    <Color x:Key="ButtonFocusedBorderColor">#FF0067C0</Color>
    <Color x:Key="ButtonFocusedTextColor">#FF0067C0</Color>

    <!-- Disabled -->
    <Color x:Key="ButtonDisabledBackgroundColor">#FFEFEFEF</Color>
    <Color x:Key="ButtonDisabledBorderColor">#FFCCCCCC</Color>
    <Color x:Key="ButtonDisabledTextColor">#FF9A9A9A</Color>

</ResourceDictionary>
